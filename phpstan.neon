includes:
    - ./phpstan-baseline.neon
    - ../../vendor/nesbot/carbon/extension.neon
    - ../../vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - ../../vendor/pestphp/pest/extension.neon

parameters:

    level: max

    paths:
        # Core analysis only - exclude Filament-heavy areas
        - ./app/Models
        - ./app/Actions
        - ./app/Datas
        - ./app/Contracts
        - ./app/DTOs
        - ./app/Enums
        - ./app/Traits
        - ./app/Facades
        - ./app/Repositories
        - ./app/Providers
        - ./app/Exceptions
        - ./app/Events
        - ./app/Rules
        - ./app/Jobs
        - ./config
        - ./database
        - ./helpers
        - ./lang
        - ./routes

    ignoreErrors:
        - '#PHPDoc tag @mixin contains unknown class #'
        - identifier: missingType.iterableValue
        - identifier: missingType.generics
        - '#Cannot cast mixed to (string|float|double|int|bool|boolean).#'
        - identifier: theCodingMachineSafe.function

    excludePaths:
        # Exclude Filament-heavy areas and vendor duplicates to prevent timeout
        - ./app/View/*
        - ./app/Http/*
        - ./app/Filament/*
        - ./packages/*
        - ./resources/*
        - ./vendor/*
        - ./build/*
        - ./docs/*
        - ./bashscripts/*
        - ./scripts/*
        - ./*/_ide_helper.php

    editorUrl: 'vscode://file/%%file%%:%%line%%'

    tmpDir: ./build/phpstan
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
